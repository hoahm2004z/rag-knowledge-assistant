# Local env for Spring (spring-dotenv). Copy to .env and fill values.
# Do NOT commit .env with real secrets.
# Do NOT use the production pharmacy MongoDB URI.
# Host port 27018 matches repo-root docker-compose.yml

MONGODB_URI=mongodb://localhost:27018/ai_pharmacy_assistant
GEMINI_API_KEY=
GEMINI_SYSTEM_PROMPT=You are AI Pharmacy Assistant. Answer in Vietnamese. Use tools for store data and documents. Do not invent prices, stock, or order status.
JWT_SECRET=
JWT_EXPIRATION_MINUTES=1440
APP_SEED_ENABLED=true
APP_SEED_FORCE=false
APP_RAG_STARTUP_INGEST=true
APP_RAG_DEBUG=false
APP_RAG_SCORE_THRESHOLD=0.25
PORT=8080
