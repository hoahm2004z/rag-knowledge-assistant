# Copy to backend/.env (do not commit real secrets)
# LOCAL MongoDB only — database dedicated to this assistant
# Host port 27018 matches docker-compose.yml (avoids conflict with other local Mongo on 27017)
MONGODB_URI=mongodb://localhost:27018/ai_pharmacy_assistant

# Gemini API (https://aistudio.google.com/apikey)
GEMINI_API_KEY=

GEMINI_SYSTEM_PROMPT=You are AI Pharmacy Assistant. Answer in Vietnamese. Use tools for store data and documents. Do not invent prices, stock, or order status.

# Base64 HMAC secret for JWT (generate your own locally; do not reuse production secrets)
JWT_SECRET=
JWT_EXPIRATION_MINUTES=1440

APP_SEED_ENABLED=true
APP_SEED_FORCE=false
APP_RAG_STARTUP_INGEST=true
APP_RAG_DEBUG=false
APP_RAG_SCORE_THRESHOLD=0.25
PORT=8080
